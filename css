* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: 'Segoe UI', Roboto, Arial, sans-serif;
  background: #f4f6fb;
  color: #1f2937;
  padding: 24px;
}

header {
  text-align: center;
  margin-bottom: 28px;
}

header h1 {
  margin: 0 0 6px;
  font-size: 2rem;
  color: #4f46e5;
}

header p {
  margin: 0;
  color: #6b7280;
}

/* Form */
form {
  max-width: 500px;
  margin: 0 auto 32px;
  background: #ffffff;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

form label {
  font-size: 0.9rem;
  font-weight: 600;
  color: #6b7280;
}

form input {
  padding: 10px 12px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  font-size: 1rem;
}

form input:focus {
  outline: none;
  border-color: #4f46e5;
}

form button {
  margin-top: 6px;
  padding: 12px;
  border: none;
  border-radius: 8px;
  background: #4f46e5;
  color: white;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
}

form button:hover { background: #4338ca; }
form button:active { transform: scale(0.98); }

/* Student grid */
#student-list {
  display: grid;
  grid-template-columns: repeat(5, 220px); /* desktop: 5 per row */
  justify-content: center; /* centers cards when row isn't full */
  gap: 16px;
  max-width: 1200px;
  margin: 0 auto;
}

@media (max-width: 900px) {
  #student-list {
    grid-template-columns: repeat(3, 220px); /* tablet: 3 per row */
  }
}

@media (max-width: 500px) {
  #student-list {
    grid-template-columns: 1fr; /* mobile: 1 per row */
    max-width: 320px;
  }
}

.student-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  gap: 8px;
  animation: pop 0.25s ease;
}

@keyframes pop {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.student-card .avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #4f46e5;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.student-card h3 {
  margin: 0;
  font-size: 1.05rem;
}

.student-card p {
  margin: 0;
  color: #6b7280;
  font-size: 0.9rem;
}

.student-card button {
  margin-top: 8px;
  align-self: flex-start;
  background: #ef4444;
  color: white;
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.2s ease;
}

.student-card button:hover { background: #dc2626; }

#empty-msg {
  text-align: center;
  color: #6b7280;
  grid-column: 1 / -1;
}
